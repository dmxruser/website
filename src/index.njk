---
layout: base.njk
title: dmxruser
---

<div class="home-intro">
  <h1 class="intro-title">hi, im dmxruser</h1>
  <div class="intro-desc">
    <p>and i make content.</p>
    <p>i dont have nothing much to say here</p>
    <p>im a youtuber after all</p>
  </div>
</div>

<div class="home-grid">
  <!-- Videos Column -->
  <div class="home-column">
    <h2 class="column-title"><a href="/videos/">videos</a></h2>
    <div class="shorts-preview">
      {%- set shortsCount = 0 %}
      {%- for video in videos %}
        {%- if video.type == 'short' and shortsCount < 2 %}
          {%- set shortsCount = shortsCount + 1 %}
          <div class="short-card glass glass-sm type-short" style="--bg-offset: {{ loop.index * 15 }}%">
            <div class="video-embed-wrapper">
              <iframe 
                src="https://www.youtube.com/embed/{{ video.id }}" 
                title="{{ video.title }}" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                referrerpolicy="strict-origin-when-cross-origin" 
                allowfullscreen>
              </iframe>
            </div>
            <div class="short-card-content-wrap">
              <span class="short-card-title"><a href="{{ video.url }}" target="_blank">{{ video.title | lower }}</a></span>
              <span class="short-card-views">{{ video.views }}</span>
            </div>
          </div>
        {%- endif %}
      {%- endfor %}
    </div>
  </div>

  <!-- Blog Column -->
  <div class="home-column">
    <h2 class="column-title"><a href="/blog/">blog</a></h2>
    <div class="blog-preview">
      {%- set latest_post = collections.posts[0] %}
      {%- if latest_post %}
        <div class="blog-preview-card glass glass-sm">
          <h3 class="blog-preview-title"><a href="{{ latest_post.url }}">{{ latest_post.data.title | lower }}</a></h3>
          <p class="blog-preview-text">
            {{ latest_post.data.description | lower }}
          </p>
          <a href="{{ latest_post.url }}" class="read-more-btn">read more</a>
        </div>
      {%- else %}
        <div class="blog-preview-card glass glass-sm">
          <h3 class="blog-preview-title">title</h3>
          <p class="blog-preview-text">
            lorem ipsum dolor sit amet, consectetur adipiscing elit. integer ac eros ac ante sollicitudin commodo sed in mauris. integer ac eros ac ante sollicitudin commodo sed in mauris.
          </p>
          <a href="/blog/" class="read-more-btn">read more</a>
        </div>
      {%- endif %}
    </div>
  </div>
</div>
