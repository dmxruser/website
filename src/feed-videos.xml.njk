---
permalink: /feed-videos.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title }} - Videos</title>
    <link>{{ site.url }}/videos/</link>
    <description>{{ site.description }}</description>
    <language>en</language>
    <atom:link href="{{ site.url }}/feed-videos.xml" rel="self" type="application/rss+xml"/>
    {%- for video in videos %}
    <item>
      <title>{{ video.title }}</title>
      <link>{{ video.url }}</link>
      <guid>{{ video.url }}</guid>
      <description>{% if video.type == 'short' %}short{% else %}video{% endif %} - {{ video.views }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
