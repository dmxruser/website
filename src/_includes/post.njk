{% extends "base.njk" %}

{% block content %}
<article class="single-post">
  <header class="post-header">
    <h1 class="post-title">{{ title | lower }}</h1>
    <div class="post-meta">
      <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate | lower }}</time>
    </div>
  </header>
  <div class="post-body">
    {{ content | safe }}
  </div>
  <footer class="post-footer">
    <a href="/blog/" class="back-to-blog">&larr; back to blog</a>
  </footer>
</article>
{% endblock %}
